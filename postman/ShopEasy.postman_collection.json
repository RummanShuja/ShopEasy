    {
      "name": "Filter and sort products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products?search=vITamin&category=Vitamins&minPrice=300&maxPrice=600&sort=price_asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "search",
              "value": "vITamin"
            },
            {
              "key": "category",
              "value": "Vitamins"
            },
            {
              "key": "minPrice",
              "value": "300"
            },
            {
              "key": "maxPrice",
              "value": "600"
            },
            {
              "key": "sort",
              "value": "price_asc"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const products = pm.response.json();",
              "pm.test('Filters and ordering are combined', () => {",
              "  pm.expect(products).to.be.an('array').that.is.not.empty;",
              "  products.forEach((p, i) => {",
              "    pm.expect(p.name.toLowerCase()).to.include('vitamin');",
              "    pm.expect(p.category).to.eql('Vitamins'); pm.expect(p.price).to.be.within(300, 600);",
              "    if (i) pm.expect(p.price).to.be.at.least(products[i - 1].price);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "First catalog page",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=0&size=8",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "8"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "pm.test('Page metadata and maximum of eight active items', () => {",
              "  pm.expect(page.page).to.eql(0); pm.expect(page.size).to.eql(8); pm.expect(page.total).to.be.at.least(16);",
              "  pm.expect(page.items).to.have.lengthOf(8); pm.expect(page.items.every(p => p.active)).to.eql(true);",
              "  pm.expect(page.hasNext).to.eql(true);",
              "});",
              "pm.environment.set('firstPageIds', JSON.stringify(page.items.map(p => p.id)));"
            ]
          }
        }
      ]
    },
