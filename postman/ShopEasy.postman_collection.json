        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Travel First Aid Kit\",\n  \"description\": \"A compact kit with gauze and bandages.\",\n  \"category\": \"First Aid\",\n  \"brand\": \"CareKit\",\n  \"price\": 499.99,\n  \"discountPercent\": 15,\n  \"stock\": 4,\n  \"imageUrl\": \"{{baseUrl}}/catalog/adhesive-bandages.webp\",\n  \"rating\": 4.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
