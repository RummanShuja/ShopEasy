{
  "info": {
    "name": "ShopEasy API",
    "description": "Use a seeded ShopEasy development database on Atlas or a local replica set. Set adminUsername and adminPassword in the active environment. The collection creates and deletes a temporary product and leaves a demo order in history. Cloudinary is optional.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database-backed service is healthy', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
