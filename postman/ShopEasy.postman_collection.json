              "pm.test('Sets an ID, a timestamp, default visibility and rounded discount', () => {",
              "  pm.expect(p.id).to.match(/^[a-f0-9]{24}$/); pm.expect(p.createdAt).to.be.a('string');",
              "  pm.expect(p.active).to.eql(true); pm.expect(p.discountedPrice).to.eql(424.99);",
              "  pm.expect(pm.response.headers.get('Location')).to.include(p.id);",
              "});",
              "if (p.id) { pm.environment.set('productId', p.id); pm.environment.set('productCreatedAt', p.createdAt); }",
              "pm.environment.set('orderUnitPrice', String(p.discountedPrice));",
              "pm.environment.set('orderStockBefore', String(p.stock));"
            ]
          }
        }
      ]
    },
    {
      "name": "Place a guest order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Guest\",\n  \"email\": \"postman-guest@example.com\",\n  \"phone\": \"+91 00000 12345\",\n  \"deliveryAddress\": {\n    \"line1\": \"24 Demo Lane\",\n    \"city\": \"Sample City\",\n    \"state\": \"Delhi\",\n    \"postalCode\": \"110001\",\n    \"country\": \"India\"\n  },\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1, \"expectedUnitPrice\": {{orderUnitPrice}} }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('orderKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.test('Returns an order snapshot and total', () => {",
              "  pm.expect(order.reference).to.match(/^SE-/); pm.expect(order.items[0].quantity).to.eql(1);",
              "  pm.expect(order.items[0].productId).to.eql(pm.environment.get('productId'));",
              "  pm.expect(order.total).to.eql(Number(pm.environment.get('orderUnitPrice')));",
              "});",
              "pm.environment.set('orderReference', order.reference);",
              "pm.test('Keeps the saved delivery details', () => {",
              "  pm.expect(order.phone).to.eql('+91 00000 12345');",
              "  pm.expect(order.deliveryAddress.line1).to.eql('24 Demo Lane');",
              "  pm.expect(order.deliveryAddress.postalCode).to.eql('110001');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry the original checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{orderKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Guest\",\n  \"email\": \"postman-guest@example.com\",\n  \"phone\": \"+91 00000 12345\",\n  \"deliveryAddress\": {\n    \"line1\": \"24 Demo Lane\",\n    \"city\": \"Sample City\",\n    \"state\": \"Delhi\",\n    \"postalCode\": \"110001\",\n    \"country\": \"India\"\n  },\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 1, \"expectedUnitPrice\": {{orderUnitPrice}} }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Retry returns the stored order reference', () => pm.expect(pm.response.json().reference).to.eql(pm.environment.get('orderReference')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Check stock after both requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Stock was decremented once', () => pm.expect(pm.response.json().stock).to.eql(Number(pm.environment.get('orderStockBefore')) - 1));"
            ]
          }
        }
      ]
    },
    {
      "name": "List admin order history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders?page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "orders"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const page = pm.response.json();",
              "const order = page.items.find(o => o.reference === pm.environment.get('orderReference'));",
              "pm.test('Order is visible with its buyer and item details', () => {",
              "  pm.expect(page.size).to.eql(10); pm.expect(order.customerName).to.eql('Postman Guest');",
              "  pm.expect(order.email).to.eql('postman-guest@example.com');",
              "  pm.expect(order.items[0].productName).to.be.a('string');",
              "});",
              "pm.test('Keeps the saved delivery details', () => {",
              "  pm.expect(order.phone).to.eql('+91 00000 12345');",
              "  pm.expect(order.deliveryAddress.line1).to.eql('24 Demo Lane');",
              "  pm.expect(order.deliveryAddress.postalCode).to.eql('110001');",
              "});"
            ]
          }
        }
      ]
    },
    {
