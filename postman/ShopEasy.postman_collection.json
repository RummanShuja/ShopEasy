      "name": "Optional Cloudinary check",
      "item": [
        {
          "name": "Upload image to Cloudinary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "images"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Sign in first, enable runUpload=true in the environment, then choose a JPG, PNG, or WebP file in the Body tab.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": null
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('runUpload') !== 'true') pm.execution.skipRequest();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns a Cloudinary HTTPS URL', () => pm.expect(pm.response.json().imageUrl).to.match(/^https:\\/\\/res\\.cloudinary\\.com\\//));"
                ]
              }
