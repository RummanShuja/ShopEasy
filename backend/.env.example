# Copy to backend/.env for local development. Use KEY=value without quotes.
# Set production values in Render. Keep your local .env private.
# Atlas alternative: mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=shopeasy-rs
MONGODB_DATABASE=shopeasy_dev
PORT=8081
# PUBLIC_API_URL defaults to localhost on PORT. Override only for a different public origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_SAMPLE_DATA=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_MIN_LENGTH=6
# Choose nonblank text for local dev. Production requires at least 32 UTF-8 bytes.
ADMIN_JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
