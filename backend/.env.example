# Copy to backend/.env for local development. Use KEY=value without quotes.
# Set production values in Render. Keep your local .env private.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=shopeasy_dev
PORT=8080
# PUBLIC_API_URL defaults to localhost on PORT. Override only for a different public origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_SAMPLE_DATA=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
